# Configuração do corte-maker.
# Copie este arquivo para `.env` (na mesma pasta) e preencha só o que for usar. O `.env` não entra no git.
# Toda opção também pode vir de uma variável de ambiente com o mesmo nome, que tem prioridade.

# --- IA (escolha dos momentos, títulos, comentários)
# Chave da API da Anthropic (paga por uso). Sem ela, o programa usa o Claude Code instalado na máquina (`claude`),
# com a sua assinatura. Sem nenhum dos dois, escolhe os cortes só pelos picos de áudio.
ANTHROPIC_API_KEY=

# --- Narração (opcional)
# Com a chave da ElevenLabs a narração usa a voz neural paga; sem ela, usa a voz local gratuita (Piper).
ELEVENLABS_API_KEY=
# Uma voz sua da ElevenLabs, que aparece como "Minha voz" na interface
ELEVENLABS_VOICE_ID=
# Modelo da ElevenLabs (padrão: eleven_multilingual_v2)
ELEVENLABS_MODEL=

# --- Seu canal
# Assinatura pequena no topo de cada corte e no canto das compilações (até 40 caracteres). Vazio: sem marca.
CORTES_MARCA=
# Endereço do site do seu app (com termos.html e privacidade.html), mostrado nas instruções do TikTok.
# Exemplo: https://seu-usuario.github.io/seu-app
CORTES_SITE_URL=

# --- Interface
# Porta da interface no navegador (padrão: 8765)
PORT=
